  "text.autoconfig.CopperEquipmentsConfigs.option.deoxidation.axeRequiredForDeoxidize": "Axe Required for Deoxidation",
  "text.autoconfig.CopperEquipmentsConfigs.option.deoxidation.axeRequiredForDeoxidize.@Tooltip": "In the crafting menu, combine an oxidized block with any axe to scrape it.",
  "text.autoconfig.CopperEquipmentsConfigs.option.deoxidation.axeDurabilityForDeoxidize": "Use Axe Durability for Deoxidation",
